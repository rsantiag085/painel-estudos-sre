# Copie este arquivo para .env e ajuste os valores para sua instalação.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# Data conhecida que representa um dia de FOLGA na sua escala 12x36.
# Substitua pela data real antes de usar a aplicação.
SCALE_ANCHOR_DATE=2030-01-01

# Opcional: caminho do banco SQLite. O padrão já funciona para uso local.
DATABASE_URL=sqlite:///./sre_tracker.db
